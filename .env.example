# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase 프로젝트 Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용. service_role 키는 RLS를 우회하므로 절대 클라이언트에 노출하지 않는다.
# AI 에이전트가 산출물을 DB에 기록할 때만 서버 라우트에서 사용한다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (AI 직원 실행) ────────────────────────────────────────────────
# 서버 라우트에서만 호출한다. 클라이언트에서 직접 호출하지 않는다.
ANTHROPIC_API_KEY=sk-ant-...
# 마케터 에이전트 기본 모델. 계정에서 사용 가능한 실제 모델 ID 를 넣는다.
# (미지정 시 claude-3-5-sonnet-latest)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Cron 보호 ───────────────────────────────────────────────────────────────
# Vercel Cron 이 /api/cron/* 를 호출할 때 사용하는 시크릿.
# Authorization: Bearer <CRON_SECRET> 로 검증한다.
CRON_SECRET=generate-a-long-random-string

# ── 앱 설정 ─────────────────────────────────────────────────────────────────
# 매직링크·카카오 콜백에 사용할 사이트 URL (로컬: http://localhost:3000, 배포: https://<도메인>)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 카카오 알림 (선택) ──────────────────────────────────────────────────────
# developers.kakao.com 앱의 REST API 키. 대표 카톡 "나에게 보내기" 알림에 사용.
# Redirect URI 에 {NEXT_PUBLIC_SITE_URL}/api/kakao/callback 을 등록한다.
KAKAO_REST_API_KEY=

# ── 이미지 생성 (선택) ──────────────────────────────────────────────────────
# fal.ai API 키. 승인 시 썸네일 자동 생성에 사용. 생성 건당 소액 과금.
# Supabase Storage에 공개 버킷 'generated-media' 를 만들어야 한다.
FAL_KEY=

# 카카오 클라이언트 시크릿을 "사용함"으로 둔 경우에만 필요. 끄면 비워둔다.
KAKAO_CLIENT_SECRET=

# ── 이메일 알림 (선택) ──────────────────────────────────────────────────────
# Resend API 키(https://resend.com 무료 가입 후 발급). 전직원 투두 등록/수정/완료 시
# 대표 이메일로 알림 발송에 사용. 미설정이면 알림은 조용히 생략된다.
RESEND_API_KEY=
# (선택) 수신 이메일. 미설정 시 대표 기본 이메일로 발송.
NOTIFY_EMAIL=
# (선택) 발신 표기. 도메인 인증 전이면 비워두면 Resend 기본 발신주소 사용.
EMAIL_FROM=
