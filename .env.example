# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase 프로젝트 Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용. service_role 키는 RLS를 우회하므로 절대 클라이언트에 노출하지 않는다.
# AI 에이전트가 산출물을 DB에 기록할 때만 서버 라우트에서 사용한다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (AI 직원 실행) ────────────────────────────────────────────────
# 서버 라우트에서만 호출한다. 클라이언트에서 직접 호출하지 않는다.
ANTHROPIC_API_KEY=sk-ant-...
# 마케터 에이전트 기본 모델. 계정에서 사용 가능한 실제 모델 ID 를 넣는다.
# (미지정 시 claude-3-5-sonnet-latest)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Cron 보호 ───────────────────────────────────────────────────────────────
# Vercel Cron 이 /api/cron/* 를 호출할 때 사용하는 시크릿.
# Authorization: Bearer <CRON_SECRET> 로 검증한다.
CRON_SECRET=generate-a-long-random-string

# ── 앱 설정 ─────────────────────────────────────────────────────────────────
# 매직링크 콜백에 사용할 사이트 URL (로컬: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
